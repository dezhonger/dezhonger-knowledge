{
  "name": "dezhonger-knowledge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1",
    "dev:puzzle": "vitepress dev puzzle --host 127.0.0.1 --port 5175",
    "sync:guwen": "node scripts/sync-guwen.mjs",
    "generate:guwen": "node scripts/sync-guwen.mjs --from-cache",
    "validate:guwen": "node scripts/validate-guwen.mjs",
    "test:guwen": "node --test scripts/guwen.test.mjs",
    "generate:elements": "node scripts/generate-elements.mjs",
    "generate:subjects": "node scripts/generate-subject-sites.mjs",
    "dev:guwen": "npm run generate:guwen && vitepress dev guwen --host 127.0.0.1 --port 5174",
    "generate:feeds": "node scripts/generate-feeds.mjs",
    "build": "vitepress build docs && node scripts/generate-feeds.mjs knowledge",
    "build:puzzle": "node scripts/ibm-research.mjs --from-cache && vitepress build puzzle && node scripts/project-euler-pages.mjs && node scripts/rosecode-pages.mjs && node scripts/generate-feeds.mjs puzzle",
    "build:guwen": "npm run generate:guwen && vitepress build guwen",
    "build:all": "npm run generate:subjects && npm run build && npm run build:guwen && npm run build:puzzle",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "preview:puzzle": "vitepress preview puzzle --host 127.0.0.1 --port 4175",
    "sync:project-euler": "node scripts/sync-project-euler.mjs",
    "generate:project-euler": "node scripts/sync-project-euler.mjs --from-cache",
    "validate:project-euler": "node scripts/validate-project-euler.mjs",
    "sync:rosecode": "node scripts/rosecode-source.mjs",
    "generate:rosecode": "node scripts/rosecode-source.mjs --from-cache",
    "validate:rosecode": "node scripts/validate-rosecode.mjs",
    "sync:ibm-research": "node scripts/ibm-research.mjs",
    "generate:ibm-research": "node scripts/ibm-research.mjs --from-cache",
    "validate:ibm-research": "node scripts/validate-ibm-research.mjs",
    "validate:pagination": "node scripts/validate-pagination.mjs",
    "generate:english": "node scripts/generate-english.mjs",
    "validate:english": "node scripts/validate-english.mjs",
    "test:english": "node --test scripts/english/*.test.mjs",
    "check:english": "node scripts/english/check.mjs",
    "build:english": "npm run check:english && npm run generate:english",
    "dev:english": "npm run generate:english && node scripts/english/preview.mjs",
    "preview:english": "node scripts/english/preview.mjs",
    "import:english": "node scripts/import-english-vocabulary.mjs",
    "pretest:english": "node scripts/generate-english.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "cheerio": "1.0.0-rc.10",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "markdown-it-mathjax3": "^4.3.2",
    "mathjax-full": "3.2.1",
    "postcss": "8.5.26",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "vite": "6.4.3"
  }
}
